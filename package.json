{
  "name": "abstract",
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/three": "^0.186.0",
    "eslint-plugin-solid": "0.18.1",
    "knip": "6.41.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sandworm": "github:danmcfan/sandworm#v0.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "check": "bun run check:static && bun test && vite build && bun scripts/check-bundle.ts",
    "playthrough": "scripts/with-server.sh scripts/playthrough.sh",
    "shots": "scripts/with-server.sh scripts/bitbox-shots.sh",
    "verify": "bun run check && bun run playthrough",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check:static": "tsc --noEmit && oxlint && prettier --check . && knip && bun scripts/check-escapes.ts",
    "sandcastle": "bun .sandcastle/main.ts",
    "sandcastle:batch": "bun .sandcastle/batch.ts"
  },
  "type": "module",
  "dependencies": {
    "solid-js": "^1.9.17",
    "three": "^0.186.1"
  }
}
